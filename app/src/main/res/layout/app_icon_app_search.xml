<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/ripple_transparent_background_16"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">
    <com.android.launcher3.BubbleTextView
        android:orientation="vertical"
        android:id="@+id/app_bubble"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginVertical="14dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/app_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.truelab.common.view.TextViewCustomFont
            android:textSize="16dp"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginHorizontal="1dp"/>
        <ImageView
            android:layout_gravity="start|top"
            android:id="@+id/app_delete"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_delete_light"/>
        <ImageView
            android:layout_gravity="start|top"
            android:id="@+id/app_select"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/unselected_icon"/>
        <TextView
            android:textColor="@android:color/white"
            android:gravity="center"
            android:layout_gravity="end|top"
            android:id="@+id/app_badge"
            android:background="@drawable/ic_badge_one"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </com.android.launcher3.BubbleTextView>
    <com.truelab.common.view.TextViewCustomFont
        android:textSize="14dp"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:id="@+id/txt_app_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:lines="1"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_toStartOf="@+id/btn_location"
        android:layout_toEndOf="@+id/app_bubble"
        app:customFont="2"/>
    <ImageView
        android:id="@+id/btn_location"
        android:background="@drawable/bg_circle"
        android:padding="10dp"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:foreground="@drawable/ripple_circle_border_bg"
        android:src="@drawable/ic_direction"
        android:tint="@color/white"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
    <View
        android:id="@+id/divider"
        android:background="@color/app_search_divider_color"
        android:layout_width="wrap_content"
        android:layout_height="0.5dp"
        android:layout_below="@+id/app_bubble"
        android:layout_marginStart="12dp"
        android:layout_toEndOf="@+id/app_bubble"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
