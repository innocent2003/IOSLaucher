<?xml version="1.0" encoding="utf-8"?>
<com.google.android.play.core.hsdp.service.HsdpLoadingPanelContainer xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:filterTouchesWhenObscured="true">
    <include
        android:id="@+id/placeholder_loading"
        android:visibility="gone"
        layout="@layout/hsdp_service_prism_with_loading_indicator"/>
    <ImageButton
        android:layout_gravity="end|top"
        android:id="@+id/sdk_dismiss_button"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:padding="0dp"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="16dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/dismiss_button_description"
        android:layout_marginEnd="16dp"/>
</com.google.android.play.core.hsdp.service.HsdpLoadingPanelContainer>
