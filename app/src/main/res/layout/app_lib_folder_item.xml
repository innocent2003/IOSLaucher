<?xml version="1.0" encoding="utf-8"?>
<com.truelab.feature.settings.custom.SwipeMenuOverlapLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_search_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/margin_8dp"
    app:contentView="@+id/container"
    app:rightView="@+id/right">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.truelab.common.view.TextViewCustomFont
            android:textSize="@dimen/medium_text_size"
            android:textColor="@color/color_content_1st"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/label"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Placeholder"
            android:lines="1"
            android:singleLine="true"
            android:layout_marginStart="20dp"
            android:layout_toStartOf="@+id/action_arrange"
            android:layout_alignParentStart="true"
            android:paddingVertical="20dp"
            app:customFont="2"/>
        <TextView
            android:id="@+id/action_arrange"
            android:padding="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:drawableEnd="@drawable/arrange_icon"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/right"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <TextView
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/txt_rename"
            android:background="#007aff"
            android:layout_width="70dp"
            android:layout_height="match_parent"
            android:text="@string/rename"/>
        <TextView
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/txt_delete"
            android:background="#ff3b30"
            android:layout_width="70dp"
            android:layout_height="match_parent"
            android:text="@string/delete"/>
    </LinearLayout>
</com.truelab.feature.settings.custom.SwipeMenuOverlapLayout>
