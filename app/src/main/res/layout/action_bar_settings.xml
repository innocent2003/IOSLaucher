<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/new_background"
    android:paddingTop="2dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.truelab.common.view.TextViewCustomFont
        android:textSize="26dp"
        android:textColor="@color/pro_main_text"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/action_bar_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/general"
        android:maxLines="1"
        android:lines="1"
        android:layout_marginVertical="4dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="10dp"
        app:customFont="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/img_save"
        app:layout_constraintStart_toEndOf="@+id/action_backs"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="56dp"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/action_backs"
        android:background="@drawable/bg_icon_back_glass"
        android:padding="8dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_arrow_close_setting"
        android:tint="@color/pro_main_text"
        android:importantForAccessibility="no"
        android:layout_marginStart="14dp"
        app:layout_constraintBottom_toBottomOf="@+id/action_bar_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/action_bar_title"/>
    <ImageView
        android:id="@+id/img_save"
        android:padding="@dimen/dp8"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:foreground="@drawable/ripple_circle_border_bg"
        android:src="@drawable/checkbox_active"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toBottomOf="@+id/action_bar_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/action_bar_title"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@+id/action_bar_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
