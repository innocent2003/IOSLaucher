<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher3.folder.Folder xmlns:android="http://schemas.android.com/apk/res/android" xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.android.launcher3.ExtendedEditText
        android:textSize="@dimen/folder_label_text_size"
        android:textColor="#fff"
        android:textColorHint="#c1c1c1"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/folder_name"
        android:background="@android:color/transparent"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/folder_hint_text"
        android:singleLine="true"
        android:imeOptions="flagNoExtractUi"
        android:paddingHorizontal="12dp"
        android:paddingVertical="@dimen/folder_label_padding_top"/>
    <FrameLayout
        android:id="@+id/real_folder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.android.launcher3.views.GlassBlurWallpaperView
            android:id="@+id/glass_blur"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.android.launcher3.folder.FolderPagedView
                android:id="@+id/folder_content"
                android:paddingLeft="8dp"
                android:paddingTop="16dp"
                android:paddingRight="8dp"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                launcher:pageIndicator="@+id/folder_page_indicator"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/folder_footer"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="5dp">
                <com.android.launcher3.pageindicators.PageIndicatorDots
                    android:layout_gravity="center_vertical"
                    android:id="@+id/folder_page_indicator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</com.android.launcher3.folder.Folder>
