<?xml version="1.0" encoding="utf-8"?>
<com.truelab.common.view.blur.OneShotBlurConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:blur_color="@color/color_blur_filter"
    app:blur_cornerRadius="36dp"
    style="@style/width_match_parent_max_492">
    <com.truelab.common.view.TextViewCustomFont
        android:textSize="15dp"
        android:id="@+id/emoji_count"
        android:background="@drawable/background_emoji_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/emoji_text"/>
    <com.truelab.common.view.TextViewCustomFont
        android:textSize="@dimen/emoji_text_size"
        android:gravity="center"
        android:id="@+id/emoji_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:customFont="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/close_button"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/close_emoji"
        android:contentDescription="@string/close"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/emoji_text"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/emoji_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/emoji_text"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/category_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/delete_button"
        app:layout_constraintEnd_toStartOf="@+id/delete_button"
        app:layout_constraintStart_toStartOf="@+id/emoji_count"
        app:layout_constraintTop_toTopOf="@+id/delete_button"/>
    <ImageView
        android:id="@+id/delete_button"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/delete_emoji"
        android:tint="@color/color_container_invert_2nd"
        android:contentDescription="@string/delete"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/emoji_list"/>
</com.truelab.common.view.blur.OneShotBlurConstraintLayout>
