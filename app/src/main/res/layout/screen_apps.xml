<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_wallpaper"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="18dp"
    android:paddingEnd="22dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:gravity="center_vertical"
        android:text="21:27      ●  ◉  ▣  ◌                         ◔  Wi-Fi  70%"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/app_search"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_glass"
        android:hint="⌕  Thư viện ứng dụng"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textColorHint="#E0E7F0"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/apps_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Đang tải ứng dụng..."
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <GridView
        android:id="@+id/apps_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:columnWidth="72dp"
        android:drawSelectorOnTop="true"
        android:horizontalSpacing="8dp"
        android:numColumns="4"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:stretchMode="columnWidth"
        android:verticalSpacing="8dp" />
</LinearLayout>