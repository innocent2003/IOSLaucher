<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/new_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/action_bar_custom"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/action_bar_settings"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_group_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_16dp"
        android:paddingVertical="@dimen/margin_16dp"
        app:layout_constraintTop_toBottomOf="@+id/action_bar_custom">
        <com.truelab.common.view.TextViewCustomFont
            android:textSize="13dp"
            android:textColor="@color/color_content_1st"
            android:ellipsize="end"
            android:id="@+id/resume_anim"
            android:layout_width="0dp"
            android:layout_height="@dimen/height_item_settings"
            android:text="@string/resume_animation"
            android:lines="1"
            android:layout_marginStart="@dimen/medium_margin"
            android:layout_marginEnd="@dimen/small_margin"
            android:paddingVertical="@dimen/item_settings_margin"
            app:customFont="2"
            app:layout_constraintEnd_toStartOf="@+id/resume_anim_setting"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.truelab.common.view.SwitchView
            android:id="@+id/resume_anim_setting"
            android:duplicateParentState="true"
            android:layout_width="@dimen/width_switch_view"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/medium_margin"
            app:layout_constraintBottom_toBottomOf="@+id/resume_anim"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/resume_anim"
            app:layout_constraintTop_toTopOf="@+id/resume_anim"/>
        <View
            android:id="@+id/divider"
            android:background="@color/divider_color"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginStart="@dimen/medium_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/resume_anim"/>
        <com.truelab.common.view.TextViewCustomFont
            android:textSize="13dp"
            android:textColor="@color/color_content_1st"
            android:ellipsize="end"
            android:id="@+id/open_anim"
            android:layout_width="0dp"
            android:layout_height="@dimen/height_item_settings"
            android:text="@string/open_close_apps_animation"
            android:lines="1"
            android:layout_marginStart="@dimen/medium_margin"
            android:layout_marginEnd="@dimen/small_margin"
            android:paddingVertical="@dimen/item_settings_margin"
            app:customFont="2"
            app:layout_constraintEnd_toStartOf="@+id/open_anim_setting"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider"/>
        <com.truelab.common.view.SwitchView
            android:id="@+id/open_anim_setting"
            android:duplicateParentState="true"
            android:layout_width="@dimen/width_switch_view"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/medium_margin"
            app:layout_constraintBottom_toBottomOf="@+id/open_anim"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/open_anim"
            app:layout_constraintTop_toTopOf="@+id/open_anim"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/native_ad_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
