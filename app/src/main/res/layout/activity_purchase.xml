<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/new_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/action_bar"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/action_bar_settings"/>
    <ScrollView
        android:id="@+id/content"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toTopOf="@+id/continue_free"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/bg_search_view"
                android:padding="@dimen/margin_8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <ImageView
                    android:id="@+id/widget_icon"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/theme_nav_wallpaper"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/orange_yellow"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/widget_icon"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.truelab.common.view.TextViewCustomFont
                        android:textSize="16dp"
                        android:textColor="@color/pro_main_text"
                        android:ellipsize="end"
                        android:id="@+id/wallpaper_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/premium_wallpapers"
                        android:maxLines="1"
                        app:customFont="2"/>
                    <com.truelab.common.view.TextViewCustomFont
                        android:textSize="@dimen/normal_text_size"
                        android:textColor="@color/pro_main_text"
                        android:id="@+id/wallpaper_des"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/purchase_description_2"
                        android:layout_toRightOf="@+id/widget_icon"
                        android:layout_alignParentBottom="true"
                        android:layout_centerInParent="true"
                        app:customFont="1"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/bg_search_view"
                android:padding="@dimen/margin_8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <ImageView
                    android:id="@+id/support_icon"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/theme_nav_profile"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/orange_yellow"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/support_icon"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.truelab.common.view.TextViewCustomFont
                        android:textSize="16dp"
                        android:textColor="@color/pro_main_text"
                        android:ellipsize="end"
                        android:id="@+id/support_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vip_supported"
                        android:maxLines="1"
                        app:customFont="2"/>
                    <com.truelab.common.view.TextViewCustomFont
                        android:textSize="@dimen/normal_text_size"
                        android:textColor="@color/pro_main_text"
                        android:id="@+id/support_des"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/purchase_description_3"
                        android:layout_toRightOf="@+id/support_icon"
                        android:layout_alignParentBottom="true"
                        android:layout_centerInParent="true"
                        app:customFont="1"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/bg_search_view"
                android:padding="@dimen/margin_8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <ImageView
                    android:id="@+id/ads_icon"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/ic_watch_ad"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/orange_yellow"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ads_icon"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.truelab.common.view.TextViewCustomFont
                        android:textSize="16dp"
                        android:textColor="@color/pro_main_text"
                        android:ellipsize="end"
                        android:id="@+id/ads_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/remove_all_ads"
                        android:maxLines="1"
                        app:customFont="2"/>
                    <com.truelab.common.view.TextViewCustomFont
                        android:textSize="@dimen/normal_text_size"
                        android:textColor="@color/pro_main_text"
                        android:id="@+id/ads_des"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/purchase_description_4"
                        android:layout_toRightOf="@+id/support_icon"
                        android:layout_alignParentBottom="true"
                        android:layout_centerInParent="true"
                        app:customFont="1"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="@dimen/small_text_size"
                android:textColor="@color/pro_main_text"
                android:gravity="center"
                android:id="@+id/auto_renew"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/auto_renewable"/>
        </LinearLayout>
    </ScrollView>
    <com.truelab.common.view.TextViewCustomFont
        android:textStyle="bold"
        android:textColor="@color/pro_main_text"
        android:gravity="center"
        android:id="@+id/continue_free"
        android:background="@drawable/bg_search_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/continue_with_contain_ads_version"
        android:drawablePadding="10dp"
        android:drawableEnd="@drawable/default_next_icon"
        android:drawableTint="@color/pro_main_text"
        android:paddingVertical="12dp"
        app:customFont="2"
        app:layout_constraintBottom_toTopOf="@+id/action_group"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/action_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/monthly"
            android:background="@drawable/bg_continue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_16dp"
            android:paddingVertical="8dp">
            <com.truelab.common.view.TextViewCustomFont
                android:textStyle="bold"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="top"
                android:id="@+id/monthly_title"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/monthly"
                android:layout_centerInParent="true"
                android:layout_alignParentStart="true"
                android:drawableTint="@color/pro_main_text"
                app:customFont="2"/>
            <com.truelab.common.view.TextViewCustomFont
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="bottom"
                android:id="@+id/monthly_price"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_toStartOf="@+id/monthly_checked"
                android:drawableTint="@color/white"
                app:customFont="2"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/monthly_checked"
                android:visibility="invisible"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_checked"
                android:layout_centerInParent="true"
                android:alpha="0.6"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/yearly"
            android:background="@drawable/bg_continue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_16dp"
            android:paddingVertical="8dp">
            <com.truelab.common.view.TextViewCustomFont
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="top"
                android:id="@+id/yearly_title"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/yearly"
                android:layout_centerInParent="true"
                android:layout_alignParentStart="true"
                app:customFont="2"/>
            <com.truelab.common.view.TextViewCustomFont
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="bottom"
                android:id="@+id/yearly_price"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/yearly_checked"
                app:customFont="2"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/yearly_checked"
                android:visibility="invisible"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_checked"
                android:layout_centerInParent="true"
                android:alpha="0.6"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/lifetime"
            android:background="@drawable/bg_continue"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_16dp"
            android:paddingVertical="8dp">
            <com.truelab.common.view.TextViewCustomFont
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="top"
                android:id="@+id/lifetime_title"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lifetime"
                android:layout_centerInParent="true"
                android:layout_alignParentStart="true"
                app:customFont="2"/>
            <com.truelab.common.view.TextViewCustomFont
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="bottom"
                android:id="@+id/lifetime_price"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/lifetime_checked"
                app:customFont="2"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/lifetime_checked"
                android:visibility="invisible"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_checked"
                android:layout_centerInParent="true"
                android:alpha="0.6"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
