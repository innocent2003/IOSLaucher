<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/new_background"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/action_bar_custom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/action_bar_settings"/>
    <com.truelab.feature.settings.custom.SafeScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/native_ad_frame"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar_custom">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/items"
                android:background="@drawable/bg_group_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/medium_margin"
                android:layout_marginVertical="@dimen/medium_margin"
                android:paddingVertical="12dp">
                <androidx.cardview.widget.CardView
                    android:id="@+id/cAppIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp12"
                    android:elevation="0dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:id="@+id/app_icon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"/>
                </androidx.cardview.widget.CardView>
                <com.truelab.feature.settings.custom.ExtendedEditText
                    android:textSize="@dimen/medium_text_size"
                    android:textColor="@color/color_content_1st"
                    android:textColorHint="#cccccc"
                    android:gravity="center_vertical"
                    android:id="@+id/edit_name"
                    android:background="@null"
                    android:focusableInTouchMode="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/app_name"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:inputType="text"
                    android:textCursorDrawable="@drawable/cursor_custom"
                    android:layout_marginStart="@dimen/margin_16dp"
                    android:layout_marginEnd="@dimen/small_margin"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/cAppIcon"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:id="@+id/reset"
                android:background="@drawable/bg_group_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/medium_margin"
                android:layout_marginVertical="@dimen/medium_margin"
                android:paddingVertical="14dp"
                app:layout_constraintTop_toBottomOf="@+id/items">
                <com.truelab.common.view.TextViewCustomFont
                    android:textSize="@dimen/medium_text_size"
                    android:textColor="@color/blue_color"
                    android:gravity="center_vertical"
                    android:id="@+id/reset_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/reset_name"
                    android:paddingStart="@dimen/medium_margin"/>
            </LinearLayout>
        </LinearLayout>
    </com.truelab.feature.settings.custom.SafeScrollView>
    <FrameLayout
        android:id="@+id/native_ad_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
