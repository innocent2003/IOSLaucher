<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/new_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/action_bar_custom"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/action_bar_settings"/>
    <FrameLayout
        android:id="@+id/settings_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/margin_16dp"
        android:layout_marginBottom="@dimen/small_margin"
        android:layout_marginHorizontal="@dimen/medium_margin"
        app:layout_constraintBottom_toTopOf="@+id/banner_ad_frame"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar_custom">
        <com.truelab.common.view.FadingRecycleView
            android:id="@+id/rcv_hidden_apps"
            android:fadingEdgeLength="30dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:requiresFadingEdge="vertical"
            android:layout_marginVertical="@dimen/small_margin"/>
        <com.truelab.common.view.TextViewCustomFont
            android:gravity="center"
            android:id="@+id/txt_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/loading_text"
            app:customFont="2"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/layout_notify_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/medium_margin"
        app:layout_constraintBottom_toTopOf="@+id/banner_ad_frame"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar_custom">
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_quick_hidden"/>
        <com.truelab.common.view.TextViewCustomFont
            android:textSize="14dp"
            android:textColor="@color/content_3rd"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/margin_16dp"
            android:text="@string/you_don_t_have_any_hidden_app"
            app:customFont="0"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/banner_ad_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
