<?xml version="1.0" encoding="utf-8"?>
<com.truelab.common.view.blur.OneShotBlurConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:background="@drawable/bg_dialog_60"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:blur_cornerRadius="24dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/option_container">
        <com.truelab.common.view.TextViewCustomFont
            android:textSize="@dimen/option_title_text_size"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="16dp"
            app:customFont="2"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.truelab.common.view.TextViewCustomFont
            android:textSize="@dimen/option_title_text_size"
            android:gravity="center"
            android:id="@+id/desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <View
            android:id="@+id/divider"
            android:background="@color/divider_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_height"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/option_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/cancel_button"/>
    <TextView
        android:textSize="@dimen/small_text_size"
        android:textStyle="bold"
        android:textColor="@color/pro_main_text"
        android:gravity="center"
        android:id="@+id/cancel_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cancel"
        android:textAllCaps="true"
        android:paddingHorizontal="@dimen/option_item_padding_vert"
        android:paddingVertical="@dimen/option_item_padding_vert"
        app:layout_constraintBottom_toBottomOf="parent"/>
</com.truelab.common.view.blur.OneShotBlurConstraintLayout>
