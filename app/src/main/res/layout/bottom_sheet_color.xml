<?xml version="1.0" encoding="utf-8"?>
<com.truelab.common.view.blur.OneShotBlurConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:blur_color="@color/color_blur_filter"
    app:blur_cornerRadius="36dp"
    style="@style/width_match_parent_max_492">
    <com.truelab.common.view.TextViewCustomFont
        android:textSize="16dp"
        android:textColor="@color/color_content_1st"
        android:gravity="center"
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/background_color"
        app:customFont="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/close_button"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/close_emoji"
        android:contentDescription="@string/close"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title_text"/>
    <GridView
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/grid_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:listSelector="#00000000"
        android:horizontalSpacing="24dp"
        android:verticalSpacing="24dp"
        android:stretchMode="columnWidth"
        android:numColumns="6"
        android:maxHeight="150dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@+id/close_button"/>
    <SeekBar
        android:id="@+id/seekbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:maxHeight="14dp"
        android:max="254"
        android:minHeight="14dp"
        android:splitTrack="false"
        android:min="100"
        app:layout_constraintEnd_toEndOf="@+id/grid_view"
        app:layout_constraintStart_toStartOf="@+id/grid_view"
        app:layout_constraintTop_toBottomOf="@+id/grid_view"/>
</com.truelab.common.view.blur.OneShotBlurConstraintLayout>
