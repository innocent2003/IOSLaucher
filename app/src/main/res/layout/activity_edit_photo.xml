<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toTopOf="parent">
        <com.truelab.common.view.TextViewCustomFont
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="#000"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="start"
            android:id="@+id/btn_cancel"
            android:background="@drawable/bg_dialog_60"
            android:layout_width="75dp"
            android:layout_height="wrap_content"
            android:minHeight="30dp"
            android:text="@string/cancel"
            android:layout_marginStart="39dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            app:customFont="2"/>
        <com.truelab.common.view.TextViewCustomFont
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="#fafafa"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/btn_done"
            android:background="@drawable/bg_continue"
            android:layout_width="75dp"
            android:layout_height="wrap_content"
            android:minHeight="30dp"
            android:text="@string/save"
            android:layout_marginEnd="39dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            app:customFont="2"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_top_bar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/top_bar">
        <ImageView
            android:id="@+id/action_undo"
            android:padding="14dp"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_redo_inactive"
            android:layout_marginStart="10dp"
            app:layout_constraintStart_toStartOf="parent"/>
        <ImageView
            android:id="@+id/action_redo"
            android:padding="14dp"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_redo"
            app:layout_constraintStart_toEndOf="@+id/action_undo"/>
        <ImageView
            android:id="@+id/action_draw"
            android:padding="14dp"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:src="@drawable/draw"
            android:layout_marginEnd="10dp"
            app:layout_constraintEnd_toStartOf="@+id/choose_photo"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/clock_selected_color"
            android:id="@+id/action_cancel_draw"
            android:padding="14dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/done"
            android:layout_marginEnd="10dp"
            app:layout_constraintEnd_toStartOf="@+id/choose_photo"/>
        <ImageView
            android:id="@+id/choose_photo"
            android:padding="14dp"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:src="0x7f0801b2"
            android:layout_marginEnd="10dp"
            app:layout_constraintEnd_toEndOf="parent"/>
        <com.truelab.common.view.TextViewCustomFont
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="#afafaf"
            android:gravity="center"
            android:id="@+id/property_group_label"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="Adjust"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:id="@+id/defer_view_top"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toStartOf="@+id/choose_photo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.truelab.common.view.TextViewCustomFont
        android:textSize="@dimen/small_text_size"
        android:textColor="@color/yellow"
        android:id="@+id/warning_editor_photo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_16dp"
        android:text="@string/get_premium_editor_photo"
        android:drawablePadding="8dp"
        android:drawableEnd="@drawable/ic_crown"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_top_bar"/>
    <com.truelab.feature.photo.editor.PhotoEditorView
        android:id="@+id/photo_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginVertical="16dp"
        app:layout_constraintBottom_toTopOf="@+id/list_properties_scroller"
        app:layout_constraintTop_toBottomOf="@+id/action_top_bar"/>
    <TextView
        android:textColor="@color/white"
        android:id="@+id/property_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Adjust"
        android:textAllCaps="true"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        app:layout_constraintBottom_toTopOf="@+id/list_properties_scroller"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <HorizontalScrollView
        android:id="@+id/list_properties_scroller"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:paddingHorizontal="24dp"
        app:layout_constraintBottom_toTopOf="@+id/focalSeekbarView">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/list_properties"
            android:layout_width="wrap_content"
            android:layout_height="58dp"/>
    </HorizontalScrollView>
    <com.truelab.common.view.FocalSeekbarView
        android:id="@+id/focalSeekbarView"
        android:layout_width="match_parent"
        android:layout_height="21dp"
        android:layout_marginBottom="11dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_nav"/>
    <com.truelab.common.view.BottomNavView
        android:id="@+id/bottom_nav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/draw_tool"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/photo_view">
        <FrameLayout
            android:id="@+id/draw_properties"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginBottom="11dp"
            app:layout_constraintBottom_toTopOf="@+id/focalSeekbarView"/>
        <com.truelab.common.view.BottomNavView
            android:id="@+id/draw_bottom_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <View
        android:id="@+id/defer_view_bottom"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@+id/list_properties_scroller"/>
</androidx.constraintlayout.widget.ConstraintLayout>
