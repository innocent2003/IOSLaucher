<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_edit_menu"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="10dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="#99FFFFFF" />

    <EditText
        android:id="@+id/widget_picker_search"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_glass"
        android:hint="@string/home_widget_search"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textColorHint="#BFC8D2"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/widget_picker_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/home_widget_none"
        android:textColor="#D6D6DF"
        android:textSize="14sp"
        android:visibility="gone" />

    <GridView
        android:id="@+id/widget_picker_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:horizontalSpacing="10dp"
        android:numColumns="2"
        android:paddingBottom="8dp"
        android:stretchMode="columnWidth"
        android:verticalSpacing="10dp" />
</LinearLayout>
