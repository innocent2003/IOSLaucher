<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/new_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/action_bar_custom"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/action_bar_settings"/>
    <com.truelab.common.view.FadingScrollView
        android:id="@+id/scroll_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="@dimen/margin_16dp"
        app:layout_constraintBottom_toTopOf="@+id/banner_ad_frame"
        app:layout_constraintTop_toBottomOf="@+id/action_bar_custom">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/preview_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_margin="@dimen/margin_16dp"
                app:layout_constraintDimensionRatio="3:2"
                app:layout_constraintTop_toTopOf="parent">
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/preview_layout"
                    android:layout_width="300dp"
                    android:layout_height="match_parent">
                    <ImageView
                        android:layout_width="150dp"
                        android:layout_height="match_parent"
                        android:src="@drawable/wallpaper_preview_icons"/>
                    <ImageView
                        android:layout_width="150dp"
                        android:layout_height="match_parent"
                        android:src="@drawable/wallpaper_preview_icons"/>
                </LinearLayout>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/small_margin"
                app:cardCornerRadius="@dimen/radius_item_settings"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@+id/preview_container">
                <com.truelab.common.view.TextViewCustomFont
                    android:textSize="13dp"
                    android:textColor="@color/color_content_1st"
                    android:ellipsize="end"
                    android:id="@+id/scroll_type_1"
                    android:background="@drawable/bg_group_settings"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_item_settings"
                    android:text="@string/default_name"
                    android:lines="1"
                    android:drawablePadding="8dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="@dimen/item_settings_margin"
                    app:customFont="2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/auto_arrange"/>
                <com.truelab.common.view.TextViewCustomFont
                    android:textSize="13dp"
                    android:textColor="@color/color_content_1st"
                    android:ellipsize="end"
                    android:id="@+id/scroll_type_2"
                    android:background="@drawable/bg_group_settings"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_item_settings"
                    android:layout_marginTop="@dimen/margin_8dp"
                    android:text="@string/rotation"
                    android:lines="1"
                    android:drawablePadding="8dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="@dimen/item_settings_margin"
                    app:customFont="2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/auto_arrange"/>
                <com.truelab.common.view.TextViewCustomFont
                    android:textSize="13dp"
                    android:textColor="@color/color_content_1st"
                    android:ellipsize="end"
                    android:id="@+id/scroll_type_3"
                    android:background="@drawable/bg_group_settings"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_item_settings"
                    android:layout_marginTop="@dimen/margin_8dp"
                    android:text="@string/flip"
                    android:lines="1"
                    android:drawablePadding="8dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="@dimen/item_settings_margin"
                    app:customFont="2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/auto_arrange"/>
                <com.truelab.common.view.TextViewCustomFont
                    android:textSize="13dp"
                    android:textColor="@color/color_content_1st"
                    android:ellipsize="end"
                    android:id="@+id/scroll_type_4"
                    android:background="@drawable/bg_group_settings"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_item_settings"
                    android:layout_marginTop="@dimen/margin_8dp"
                    android:text="@string/zoom_in"
                    android:lines="1"
                    android:drawablePadding="8dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="@dimen/item_settings_margin"
                    app:customFont="2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/auto_arrange"/>
                <com.truelab.common.view.TextViewCustomFont
                    android:textSize="13dp"
                    android:textColor="@color/color_content_1st"
                    android:ellipsize="end"
                    android:id="@+id/scroll_type_5"
                    android:background="@drawable/bg_group_settings"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_item_settings"
                    android:layout_marginTop="@dimen/margin_8dp"
                    android:text="@string/alpha"
                    android:lines="1"
                    android:drawablePadding="8dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="@dimen/item_settings_margin"
                    app:customFont="2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/auto_arrange"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.truelab.common.view.FadingScrollView>
    <FrameLayout
        android:id="@+id/banner_ad_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/medium_margin"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
