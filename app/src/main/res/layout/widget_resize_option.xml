<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:layout_marginVertical="2dp">
    <ImageView
        android:id="@+id/size_1x1"
        android:background="@drawable/widget_resize_background"
        android:padding="8dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:foreground="@drawable/ripple_transparent_background_16"
        android:src="@drawable/ic_widget_1x1"
        android:layout_marginHorizontal="8dp"/>
    <ImageView
        android:id="@+id/size_2x2"
        android:background="@drawable/widget_resize_background"
        android:padding="8dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:foreground="@drawable/ripple_transparent_background_16"
        android:src="@drawable/ic_widget_2x2"
        android:layout_marginEnd="8dp"/>
    <ImageView
        android:id="@+id/size_4x2"
        android:background="@drawable/widget_resize_background"
        android:padding="8dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:foreground="@drawable/ripple_transparent_background_16"
        android:src="@drawable/ic_widget_4x2"/>
    <ImageView
        android:id="@+id/size_4x4"
        android:background="@drawable/widget_resize_background"
        android:padding="8dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:foreground="@drawable/ripple_transparent_background_16"
        android:src="@drawable/ic_widget_4x4"
        android:layout_marginHorizontal="8dp"/>
</LinearLayout>
