<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1px"
        app:cardBackgroundColor="#4deeeeee"
        app:cardCornerRadius="@dimen/card_round_corner_search"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@+id/close_ad_button">
        <FrameLayout
            android:id="@+id/fl_adplaceholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_container"
            android:paddingBottom="@dimen/all_apps_native_padding"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shimmer_auto_start="true"
            app:shimmer_base_color="#ccc">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ad_constraint_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/ad_ic"
                    android:background="@drawable/ic_ads_native_round"
                    android:paddingTop="3dp"
                    android:paddingEnd="6dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/AdsMarkRight"/>
                <androidx.cardview.widget.CardView
                    android:id="@+id/ad_image"
                    android:layout_width="@dimen/native_ad_image_size"
                    android:layout_height="@dimen/native_ad_image_size"
                    android:layout_marginTop="@dimen/all_apps_native_padding"
                    android:layout_marginStart="@dimen/all_apps_native_padding"
                    app:cardCornerRadius="14dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:id="@+id/ad_content_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </androidx.cardview.widget.CardView>
                <TextView
                    android:textSize="15dp"
                    android:ellipsize="end"
                    android:id="@+id/ad_headline"
                    android:background="@color/shimmer_content"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/all_apps_native_padding"
                    android:maxLines="2"
                    android:layout_marginStart="@dimen/all_apps_native_content_margin"
                    android:layout_marginEnd="@dimen/all_apps_native_content_margin"
                    app:layout_constraintEnd_toStartOf="@+id/ad_call_to_action"
                    app:layout_constraintStart_toEndOf="@+id/ad_image"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12sp"
                    android:ellipsize="end"
                    android:id="@+id/ad_content"
                    android:background="@color/shimmer_content"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="1"
                    android:layout_marginStart="@dimen/all_apps_native_content_margin"
                    android:layout_marginEnd="@dimen/all_apps_native_content_margin"
                    app:layout_constraintEnd_toStartOf="@+id/ad_call_to_action"
                    app:layout_constraintStart_toEndOf="@+id/ad_image"
                    app:layout_constraintTop_toBottomOf="@+id/ad_headline"/>
                <RatingBar
                    android:id="@+id/ad_stars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginStart="@dimen/all_apps_native_content_margin"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ad_image"
                    app:layout_constraintTop_toBottomOf="@+id/ad_content"
                    style="?android:attr/ratingBarStyleSmall"/>
                <Button
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:id="@+id/ad_call_to_action"
                    android:background="@drawable/bg_native_search_action_button"
                    android:padding="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:maxWidth="@dimen/ad_buttom_max_width"
                    android:layout_marginEnd="@dimen/all_app_native_padding_small"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>
    </androidx.cardview.widget.CardView>
    <TextView
        android:textSize="8dp"
        android:textColor="#ffffff"
        android:id="@+id/close_ad_button"
        android:background="@drawable/ic_close_ads_native_background"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:src="@drawable/ic_close_ads_native"
        android:text="@string/remove_ad"
        android:drawableRight="@drawable/ic_close_ads_native"
        android:drawablePadding="2dp"
        android:paddingHorizontal="7dp"
        android:paddingVertical="2dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
