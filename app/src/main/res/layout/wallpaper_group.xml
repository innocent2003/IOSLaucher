<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.truelab.common.view.TextViewCustomFont
        android:textSize="@dimen/larger_text_size"
        android:textColor="@color/color_content_1st"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        app:customFont="2"
        app:layout_constraintBottom_toBottomOf="@+id/see_all"
        app:layout_constraintEnd_toStartOf="@+id/see_all"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/see_all"/>
    <ImageView
        android:id="@+id/see_all"
        android:background="@drawable/circle_border_stroke_bg"
        android:padding="5dp"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:src="@drawable/ic_arrow_forward"
        android:tint="@color/second_text"
        android:layout_marginEnd="@dimen/margin_16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/wallpaper_items"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/margin_16dp"
        app:layout_constraintTop_toBottomOf="@+id/see_all"/>
</androidx.constraintlayout.widget.ConstraintLayout>
