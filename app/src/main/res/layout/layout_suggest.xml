<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/suggest_content"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="8dp">
    <com.truelab.common.view.TextViewCustomFont
        android:textSize="14dp"
        android:textColor="@color/app_search_title_primary"
        android:ellipsize="end"
        android:gravity="left"
        android:id="@+id/app_suggest"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/suggestions"
        android:maxLines="1"
        android:lines="1"
        android:paddingEnd="16dp"
        android:layout_marginStart="8dp"
        android:paddingVertical="8dp"
        app:customFont="2"
        app:layout_constraintEnd_toStartOf="@+id/show_more"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.truelab.common.view.TextViewCustomFont
        android:textSize="14dp"
        android:textColor="@color/app_search_title_primary"
        android:id="@+id/show_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/see_more_text"
        android:layout_marginEnd="8dp"
        android:paddingVertical="8dp"
        app:customFont="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.android.launcher3.views.ExpandableLayout
        android:id="@+id/expand_suggestion"
        android:background="@drawable/expand_background"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:contentLayout="@layout/expand_content_layout"
        app:headerLayout="@layout/layout_app_suggestion"
        app:layout_constraintTop_toBottomOf="@+id/app_suggest"/>
</androidx.constraintlayout.widget.ConstraintLayout>
