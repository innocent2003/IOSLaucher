<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/app_action_info"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:gravity="center"
            android:text="ⓘ"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Thông tin ứng dụng"
            android:textColor="#F3F9FF"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/app_action_select"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:gravity="center"
            android:text="✓"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Chọn"
            android:textColor="#F3F9FF"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/app_action_hide"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:gravity="center"
            android:text="◌"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Ẩn ứng dụng"
            android:textColor="#F3F9FF"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/app_action_edit"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:gravity="center"
            android:text="✎"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Chỉnh sửa"
            android:textColor="#F3F9FF"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/app_action_delete"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:gravity="center"
            android:text="−"
            android:textColor="#FFB3B3"
            android:textSize="22sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Xóa ứng dụng"
            android:textColor="#FFB3B3"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
