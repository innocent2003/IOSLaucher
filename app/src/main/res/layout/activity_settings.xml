<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/new_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.truelab.common.view.FadingScrollView
        android:fadingEdgeLength="60dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:requiresFadingEdge="vertical">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_settings_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:id="@+id/system_bar_view"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.truelab.common.view.TextViewCustomFont
                    android:textSize="26dp"
                    android:textColor="@color/pro_main_text"
                    android:gravity="center"
                    android:id="@+id/settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings"
                    android:drawablePadding="8dp"
                    android:drawableEnd="@drawable/ic_verify"
                    android:layout_marginStart="@dimen/dp24"
                    app:customFont="2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/system_bar_view"
                    app:layout_constraintVertical_bias="0"/>
                <com.truelab.common.view.TextViewCustomFont
                    android:textSize="13dp"
                    android:textColor="@color/pro_main_text"
                    android:gravity="center"
                    android:id="@+id/explore"
                    android:background="@drawable/bg_group_settings"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_screen"
                    android:drawablePadding="@dimen/dp8"
                    android:drawableEnd="@drawable/ic_explore_right"
                    android:layout_marginEnd="@dimen/margin_16"
                    app:customFont="2"
                    app:layout_constraintBottom_toBottomOf="@+id/settings"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/settings"/>
                <com.truelab.common.view.TextViewCustomFont
                    android:textSize="12dp"
                    android:textColor="@color/pro_main_text"
                    android:gravity="start|center_vertical"
                    android:id="@+id/description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/setting_description"
                    android:layout_marginHorizontal="@dimen/margin_16dp"
                    app:customFont="1"
                    app:layout_constraintTop_toBottomOf="@+id/explore"/>
                <androidx.cardview.widget.CardView
                    android:id="@+id/premium_preview"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/margin_16dp"
                    android:layout_marginHorizontal="@dimen/margin_16dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:layout_constraintDimensionRatio="2:1"
                    app:layout_constraintTop_toBottomOf="@+id/description">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_premium_preview"/>
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_16dp"
                    android:layout_marginHorizontal="@dimen/margin_16dp"
                    app:layout_constraintTop_toBottomOf="@+id/premium_preview">
                    <com.truelab.common.view.TextViewCustomFont
                        android:textSize="13dp"
                        android:textColor="@color/blue_color"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/premium"
                        android:background="@drawable/bg_search_view"
                        android:padding="8dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/premium"
                        android:lines="2"
                        android:drawablePadding="8dp"
                        android:layout_weight="1"
                        android:drawableEnd="@drawable/ic_crown"
                        android:layout_marginEnd="8dp"
                        app:customFont="3"/>
                    <com.truelab.common.view.TextViewCustomFont
                        android:textSize="13dp"
                        android:textColor="@color/blue_color"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/rate"
                        android:background="@drawable/bg_search_view"
                        android:padding="8dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/rate_app"
                        android:lines="2"
                        android:drawablePadding="8dp"
                        android:layout_weight="1"
                        android:drawableEnd="@drawable/ic_heart"
                        android:layout_marginHorizontal="8dp"
                        app:customFont="3"/>
                    <com.truelab.common.view.TextViewCustomFont
                        android:textSize="13dp"
                        android:textColor="@color/color_content_2nd"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/app_version"
                        android:background="@drawable/bg_search_view"
                        android:padding="8dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Ver 1.0.1"
                        android:lines="2"
                        android:drawablePadding="8dp"
                        android:layout_weight="1"
                        android:alpha="0.7"
                        android:drawableEnd="@drawable/ic_settings_info"
                        android:layout_marginStart="8dp"
                        android:drawableTint="@color/pro_main_text"
                        app:customFont="3"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:id="@+id/cross_banner_container"
                android:background="@drawable/bg_group_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_16dp"
                android:layout_marginHorizontal="@dimen/medium_margin">
                <com.truelab.feature.cross.views.CrossView
                    android:id="@+id/cross_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:textColor="@color/color_content_1st"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/native_ad_frame"
                android:visibility="visible"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_16dp"
                android:layout_marginHorizontal="@dimen/medium_margin"/>
            <com.truelab.common.view.TextViewCustomFont
                android:textSize="13dp"
                android:textColor="@color/pro_main_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                android:text="@string/general"
                android:layout_marginHorizontal="@dimen/dp24"
                app:customFont="2"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_group_settings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/medium_margin"
                android:layout_marginVertical="@dimen/small_margin">
                <com.truelab.feature.settings.custom.SettingsItem
                    android:id="@+id/set_default_home_screen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:settingIcon="@drawable/ic_setting_default"
                    app:settingText="@string/select_default_home_screen"/>
                <com.truelab.feature.settings.custom.SettingsItem
                    android:id="@+id/general_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:settingIcon="@drawable/ic_setting_general"
                    app:settingText="@string/general"/>
                <com.truelab.feature.settings.custom.SettingsItem
                    android:id="@+id/wallpaper_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:settingIcon="0x7f080248"
                    app:settingText="@string/wallpaper"/>
                <com.truelab.feature.settings.custom.SettingsItem
                    android:id="@+id/weather_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:settingIcon="@drawable/weather_icon"
                    app:settingText="@string/weather"/>
                <com.truelab.feature.settings.custom.SettingsItem
                    android:id="@+id/appearance_setting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hideDivider="true"
                    app:settingIcon="@drawable/ic_setting_appearance"
                    app:settingText="@string/appearance"/>
            </LinearLayout>
            <com.truelab.common.view.TextViewCustomFont
                android:textSize="13dp"
                android:textColor="@color/pro_main_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                android:text="@string/desktop_transition"
                android:layout_marginHorizontal="@dimen/dp24"
                app:customFont="2"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_group_settings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/medium_margin"
                android:layout_marginVertical="@dimen/small_margin">
                <com.truelab.feature.settings.custom.SettingsItem
                    android:id="@+id/page_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:settingIcon="@drawable/ic_green_grid"
                    app:settingText="@string/screen_grid"/>
                <com.truelab.feature.settings.custom.SettingsItem
                    android:id="@+id/page_transition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:settingIcon="@drawable/ic_setting_transition"
                    app:settingText="@string/workspace_transition_effect"/>
                <com.truelab.feature.settings.custom.SettingsItem
                    android:id="@+id/app_library_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:settingIcon="@drawable/ic_setting_library"
                    app:settingText="@string/app_library"/>
                <com.truelab.feature.settings.custom.SettingsItem
                    android:id="@+id/app_animation_settings"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:settingIcon="@drawable/ic_app_animation_settings"
                    app:settingText="@string/app_animation"/>
                <com.truelab.feature.settings.custom.SettingsItem
                    android:id="@+id/badge_notifications_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hideDivider="true"
                    app:settingIcon="@drawable/ic_setting_badge"
                    app:settingText="@string/badge_notifications"/>
            </LinearLayout>
            <com.truelab.common.view.TextViewCustomFont
                android:textSize="13dp"
                android:textColor="@color/pro_main_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                android:text="@string/icon_customization"
                android:layout_marginHorizontal="@dimen/dp24"
                app:customFont="2"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_group_settings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/medium_margin"
                android:layout_marginVertical="@dimen/small_margin">
                <com.truelab.feature.settings.custom.SettingsItem
                    android:id="@+id/hidden_apps_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:settingIcon="@drawable/ic_setting_hidden"
                    app:settingText="@string/hidden_apps"/>
                <com.truelab.feature.settings.custom.SettingsItem
                    android:id="@+id/change_app_icon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:settingIcon="@drawable/ic_setting_icon"
                    app:settingText="@string/change_app_icon"/>
                <com.truelab.feature.settings.custom.SettingsItem
                    android:id="@+id/change_icon_pack"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:settingIcon="@drawable/ic_setting_icon_pack"
                    app:settingText="@string/icon_packs"/>
                <com.truelab.feature.settings.custom.SettingsItem
                    android:id="@+id/change_app_name_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:settingIcon="@drawable/ic_setting_label"
                    app:settingText="@string/change_app_name"/>
                <com.truelab.feature.settings.custom.SettingsItem
                    android:id="@+id/language_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hideDivider="true"
                    app:settingIcon="@drawable/ic_setting_language"
                    app:settingText="@string/language"/>
            </LinearLayout>
            <com.truelab.common.view.TextViewCustomFont
                android:textSize="13dp"
                android:textColor="@color/pro_main_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                android:text="@string/contacts_us"
                android:layout_marginHorizontal="@dimen/dp24"
                app:customFont="2"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_group_settings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/medium_margin"
                android:layout_marginVertical="@dimen/item_settings_margin">
                <com.truelab.feature.settings.custom.SettingsItem
                    android:id="@+id/download_other"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:settingIcon="@drawable/ic_setting_download"
                    app:settingText="@string/download_other_app"/>
                <com.truelab.feature.settings.custom.SettingsItem
                    android:id="@+id/privacy_policy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hideDivider="true"
                    app:settingIcon="@drawable/ic_setting_policy"
                    app:settingText="@string/privacy_policy"/>
            </LinearLayout>
            <View
                android:id="@+id/bottom_bar_view"
                android:layout_width="match_parent"
                android:layout_height="48dp"/>
        </LinearLayout>
    </com.truelab.common.view.FadingScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
