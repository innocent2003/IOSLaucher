<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/new_selector_clickable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/divider_line"
        android:background="@color/divider_color"
        android:layout_width="0dp"
        android:layout_height="1px"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/content_text"/>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/arrowImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/ic_setting_arrow"
        android:layout_marginEnd="@dimen/medium_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.2"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/settings_icon"
        android:padding="@dimen/dp4"
        android:layout_width="@dimen/setting_icon_size"
        android:layout_height="@dimen/setting_icon_size"
        android:layout_marginStart="@dimen/dp8"
        android:layout_marginVertical="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/red_dot"
        android:background="@drawable/ic_red_dot"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="4dp"
        app:layout_constraintRight_toRightOf="@+id/settings_icon"
        app:layout_constraintTop_toTopOf="@+id/settings_icon"/>
    <LinearLayout
        android:gravity="start"
        android:orientation="vertical"
        android:id="@+id/content_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/medium_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/arrowImage"
        app:layout_constraintStart_toEndOf="@+id/settings_icon"
        app:layout_constraintTop_toTopOf="parent">
        <com.truelab.common.view.TextViewCustomFont
            android:textSize="13dp"
            android:textColor="@color/cross_text_color"
            android:gravity="start"
            android:id="@+id/settings_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/item_settings_margin"
            app:customFont="2"/>
        <com.truelab.common.view.TextViewCustomFont
            android:textSize="@dimen/small_text_size"
            android:gravity="start"
            android:id="@+id/description"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:customFont="1"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
