<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer_container"
    android:background="@drawable/card_shimmer_ads"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:shimmer_auto_start="false"
    app:shimmer_base_color="#ccc">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/shimmer_icon"
            android:background="@color/shimmer_content"
            android:clickable="false"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/shimmer_headline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:textColor="@color/shimmer_content"
            android:ellipsize="end"
            android:id="@+id/shimmer_headline"
            android:background="@color/shimmer_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp2"
            android:maxLines="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="@dimen/dp8"
            app:layout_constraintBottom_toTopOf="@+id/shimmer_body"
            app:layout_constraintEnd_toStartOf="@+id/shimmer_action"
            app:layout_constraintStart_toEndOf="@+id/shimmer_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:id="@+id/ads_mark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/shimmer_body"
            app:layout_constraintStart_toStartOf="@+id/shimmer_headline"
            app:layout_constraintTop_toBottomOf="@+id/shimmer_headline"
            style="@style/AdsMarkZeroPage"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/shimmer_content"
            android:ellipsize="end"
            android:id="@+id/shimmer_body"
            android:background="@color/shimmer_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/shimmer_action"
            app:layout_constraintStart_toEndOf="@+id/ads_mark"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/shimmer_content"
            android:gravity="center"
            android:id="@+id/shimmer_action"
            android:background="@color/shimmer_content"
            android:layout_width="70dp"
            android:layout_height="30dp"
            android:textAllCaps="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
