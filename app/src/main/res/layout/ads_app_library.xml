<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp">
    <com.android.launcher3.views.GlassFrameLayout
        android:id="@+id/lib_blur_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/ads_frame"
        app:layout_constraintEnd_toEndOf="@+id/ads_frame"
        app:layout_constraintStart_toStartOf="@+id/ads_frame"
        app:layout_constraintTop_toTopOf="@+id/ads_frame"/>
    <FrameLayout
        android:id="@+id/ads_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.truelab.common.view.TextViewCustomFont
        android:textSize="13dp"
        android:textColor="@android:color/white"
        android:ellipsize="end"
        android:layout_gravity="center_horizontal"
        android:id="@+id/txt_libs_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Category"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ads_frame"/>
</androidx.constraintlayout.widget.ConstraintLayout>
