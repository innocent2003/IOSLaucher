<?xml version="1.0" encoding="utf-8"?>
<com.truelab.common.view.blur.OneShotBlurConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    app:blur_color="@color/color_blur_filter"
    app:blur_cornerRadius="36dp"
    style="@style/width_match_parent_max_492">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_lock"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.cardview.widget.CardView
            android:id="@+id/previewLock"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="36dp"
            android:layout_marginEnd="@dimen/margin_16"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintDimensionRatio="1:2"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/previewHome"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.3">
            <ImageView
                android:id="@+id/bgLock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
            <ImageView
                android:id="@+id/imageLock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_lock_preview"/>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/previewHome"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/previewLock"
            app:layout_constraintDimensionRatio="1:2"
            app:layout_constraintLeft_toRightOf="@+id/previewLock"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/previewLock"
            app:layout_constraintWidth_percent="0.3">
            <ImageView
                android:id="@+id/bgHome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
            <ImageView
                android:id="@+id/imageHome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/wallpaper_preview_icons"/>
        </androidx.cardview.widget.CardView>
        <com.truelab.common.view.TextViewCustomFont
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#fafafa"
            android:gravity="center"
            android:id="@+id/set_default"
            android:background="@drawable/bg_button_continue_state"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/set_default_lock_screen"
            android:paddingVertical="14dp"
            app:customFont="3"
            app:layout_constraintEnd_toEndOf="@+id/previewHome"
            app:layout_constraintStart_toStartOf="@+id/previewLock"
            app:layout_constraintTop_toBottomOf="@+id/previewLock"/>
        <com.truelab.common.view.TextViewCustomFont
            android:textSize="14dp"
            android:textColor="@color/color_content_1st"
            android:gravity="center"
            android:id="@+id/customize_home"
            android:background="@drawable/background_custom_home_screen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:text="@string/customize_home_screen"
            android:paddingVertical="14dp"
            app:customFont="3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/set_default"
            app:layout_constraintStart_toStartOf="@+id/set_default"
            app:layout_constraintTop_toBottomOf="@+id/set_default"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.truelab.common.view.blur.OneShotBlurConstraintLayout>
