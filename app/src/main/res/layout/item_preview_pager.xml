<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:id="@+id/preview_lock"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="4dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="6:10"
        app:layout_constraintEnd_toStartOf="@+id/preview_home"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="@dimen/wallpaper_preview_width_ratio">
        <ImageView
            android:id="@+id/bg_lock"
            android:background="@color/colorPrimary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <ImageView
            android:id="@+id/imageLock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_lock_preview"/>
        <com.truelab.common.view.TextViewCustomFont
            android:textSize="12dp"
            android:textColor="#fff"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/custom_lock"
            android:background="@drawable/set_new_wallpaper_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/customize"
            android:backgroundTint="#4dffffff"
            android:paddingHorizontal="16dp"
            android:paddingVertical="3dp"/>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@+id/preview_home"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="6:10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/preview_lock"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="@dimen/wallpaper_preview_width_ratio">
        <ImageView
            android:id="@+id/bg_home"
            android:background="@color/colorPrimary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <ImageView
            android:id="@+id/imageHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/wallpaper_preview_icons"/>
        <com.truelab.common.view.TextViewCustomFont
            android:textSize="12dp"
            android:textColor="#fff"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/custom_home"
            android:background="@drawable/set_new_wallpaper_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/customize"
            android:backgroundTint="#4dffffff"
            android:paddingHorizontal="16dp"
            android:paddingVertical="3dp"/>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
