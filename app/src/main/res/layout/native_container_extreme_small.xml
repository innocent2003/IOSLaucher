<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#fff"
    app:cardCornerRadius="@dimen/native_small_default_radius">
    <FrameLayout
        android:id="@+id/fl_adplaceholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:shimmer_auto_start="false">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:id="@+id/icon_container_shimmer"
                android:layout_width="68dp"
                android:layout_height="68dp"
                app:cardCornerRadius="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/shimmer_icon"
                    android:background="@color/shimmer_content"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#000"
                android:id="@+id/shimmer_title"
                android:background="@color/shimmer_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/icon_container_shimmer"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="8dp"
                android:textStyle="bold"
                android:textColor="#000"
                android:gravity="center"
                android:id="@+id/ad_mark_shimmer"
                android:background="@drawable/ad_mark_background"
                android:layout_width="27dp"
                android:layout_height="14dp"
                android:layout_marginTop="2dp"
                android:text="Ad"
                app:layout_constraintStart_toStartOf="@+id/shimmer_title"
                app:layout_constraintTop_toBottomOf="@+id/shimmer_title"/>
            <RatingBar
                android:id="@+id/ad_stars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:stepSize="0.5"
                android:isIndicator="true"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/ad_mark_shimmer"
                app:layout_constraintStart_toEndOf="@+id/ad_mark_shimmer"
                app:layout_constraintTop_toTopOf="@+id/ad_mark_shimmer"
                style="?android:attr/ratingBarStyleSmall"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#666666"
                android:ellipsize="end"
                android:id="@+id/shimmer_body"
                android:background="@color/shimmer_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=" \10 "
                android:maxLines="2"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toStartOf="@+id/ad_call_to_action"
                app:layout_constraintStart_toStartOf="@+id/shimmer_title"
                app:layout_constraintTop_toBottomOf="@+id/ad_mark_shimmer"/>
            <Button
                android:textSize="12dp"
                android:textColor="#fff"
                android:id="@+id/ad_call_to_action"
                android:background="@drawable/bg_native_button"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:backgroundTint="#007aff"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/shimmer_title"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</androidx.cardview.widget.CardView>
